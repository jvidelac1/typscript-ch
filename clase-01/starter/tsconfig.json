{
  "compilerOptions": {
    // Version de JS que se asume como destino. es2023 = JS moderno
    // asi TS no tiene que bajar la sintaxis a JS antiguo
    "target": "es2023",
    // habilita los import/export de JS moderno
    "module": "esnext",
    "lib": ["ES2023", "DOM"],
    "types": ["vite/client"],
    // permite usar extensiones arbitrarias como .ts .vue 
    "allowArbitraryExtensions": true,
    "skipLibCheck": true,

    /* Bundler mode */
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    // Trata cada file como un modulo independiente, aunque no import/export. Evita choques entre nombres de archivos
    "moduleDetection": "force",
    "noEmit": true,

    /* Linting */
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "erasableSyntaxOnly": true,
    "noFallthroughCasesInSwitch": true
  },
  "include": ["src"]
}
